# ==============================================================================
# RAKA — Domain AI for Citizen Problem Intelligence
# Environment Configuration Template
# ==============================================================================

# Google Gemini API Key (Required for Multimodal AI Analysis, Embeddings & Copilot)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# Local SQLite (default if DATABASE_URL is not set): raka.db
# PostgreSQL / Supabase (optional for enterprise scale):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/raka_db
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-key

# Server Runtime Settings
PORT=8000
HOST=0.0.0.0

# Platform Modes
# 0 = Production live mode (calls live AI for all analyses)
# 1 = Safe Demo mode (uses grounded deterministic fallbacks when API quotas are constrained)
RAKA_DEMO_MODE=0

# Speech-to-Text & Audio
# Supports local webm/wav/mp3 audio uploads with automated language detection
# (English, Hindi, Marathi, Bengali, Tamil, Telugu, Gujarati, Kannada, Malayalam, Punjabi, Urdu)
